{
"covet_engine_sohc_small": {
    "information":{
        "authors":"BeamNG",
        "name":"1.3L SOHC I4 Engine",
        "value":1900,
    },
    "slotType" : "covet_engine",
    "slots": [
        ["type", "default", "description"],
        ["covet_intake_1.3","covet_intake_1.3_carb", "Intake & Exhaust", {"coreSlot":true}],
        ["covet_oilpan","covet_oilpan", "Oil Pan", {"coreSlot":true}],
        ["covet_engine_internals","covet_engine_internals", "Engine Long Block", {"coreSlot":true}],
        ["n2o_system","", "Nitrous Oxide System"],
        ["covet_engine_ecu","covet_engine_ecu", "Engine Management", {"coreSlot":true}],
        ["covet_transmission","covet_transmission_4M", "Transmission"],
        ["covet_enginemounts","covet_enginemounts", "Engine Mounts", {"coreSlot":true}],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine": {
        "torque":[
            ["rpm", "torque"],
            [0,       0],
            [500,    40],
            [1000,  66],
            [2000,  105],
            [3000,  125],
            [4000,  134],
            [5000,  132],
            [6000,  120],
            [7000,  108],
            [8000,  87],
            [9000,   51],
            [10000,  23],
            [11000,  14],
        ],

         //max rpm physically capable of
        "idleRPM":800,
        "maxRPM":6800,
        "hasRevLimiter":false,
        "inertia":0.06,
        "friction":10,
        "dynamicFriction":0.019
        "engineBrakeTorque":26,
        //"burnEfficiency":0.30
        "burnEfficiency":[
            [0, 0.12],
            [0.05, 0.32],
            [0.4, 0.44],
            [0.7, 0.51],
            [1, 0.38],
        ],
        //fuel system
        "energyStorage": ["mainTank","fueltank_R", "fueltank_L"],
        "requiredEnergyType":"gasoline",

        //exhaust
        "instantAfterFireSound": "event:>Vehicle>Afterfire>i4_01>single",
        "sustainedAfterFireSound": "event:>Vehicle>Afterfire>i4_01>multi",
        "shiftAfterFireSound": "event:>Vehicle>Afterfire>i4_01>shift",
        "particulates":0.03,
        "instantAfterFireCoef": 0.5,
        "sustainedAfterFireCoef": 0.5,
        "instantAfterFireVolumeCoef": 0.6,
        "sustainedAfterFireVolumeCoef": 0.3,
        "shiftAfterFireVolumeCoef": 0.5,

        //cooling and oil system
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminum",
        "oilVolume":3.5,
        "engineBlockAirCoolingEfficiency":22,

        //engine durability
        "cylinderWallTemperatureDamageThreshold":130,
        "headGasketDamageThreshold":1500000,
        "pistonRingDamageThreshold":1500000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 150,
        "maxOverTorqueDamage": 200,

        //node beam interface
        "torqueReactionNodes:":["e1l","e2l","e4r"],
        "waterDamage": {"[engineGroup]:":["engine_intake"]},
        "radiator": {"[engineGroup]:":["radiator"]},
        "engineBlock": {"[engineGroup]:":["engine_block"]},
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>i4_2001_eng",
        "starterSampleExhaust":"event:>Engine>Starter>i4_2001_exh",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i4_2001_eng",
        "shutOffSampleExhaust":"event:>Engine>Shutoff>i4_2001_exh",
        "starterVolume":0.76,
        "starterVolumeExhaust":0.76,
        "shutOffVolumeEngine":0.76,
        "shutOffVolumeExhaust":0.76,
        "starterThrottleKillTime":0.5,
        "idleRPMStartRate":1,
        "idleRPMStartCoef":1,

        //damage deformGroups
        "deformGroups":["mainEngine", "mainEngine_piping", "mainEngine_accessories"]
        "deformGroups_oilPan":["oilpan_damage"]
    },
    "soundConfig": {
        "sampleName": "b4p_1995_02000cc_modified_01_engine",
        "intakeMuffling": 0.5,

        "mainGain": -5,
        "onLoadGain":1,
        "offLoadGain":0.45,

        "maxLoadMix": 10.0,
        "minLoadMix": 0,

        "lowShelfGain":-5,
        "lowShelfFreq":80,

        "highShelfGain":1,
        "highShelfFreq":2500,

        "eqLowGain": -6,
        "eqLowFreq": 500,
        "eqLowWidth": 0.1,

        "eqHighGain": 0,
        "eqHighFreq": 2500,
        "eqHighWidth": 0.2,

        "fundamentalFrequencyCylinderCount":4,
        "eqFundamentalGain": -4,
    },
    "soundConfigExhaust": {
        "sampleName": "i4p_01600cc_motorsport_03_exhaust",

        "eqFundamentalGain":0,

        "eqHighFreq":4000,
        "eqHighGain":0,
        "eqHighWidth":0.1000000015,
  
        "eqLowFreq":90,
        "eqLowGain":0,
        "eqLowWidth":0.5,

        "fundamentalFrequencyCylinderCount":4,

        "highShelfFreq":1200,
        "highShelfGain":-30,

        "lowShelfFreq":665,
        "lowShelfGain":30,

