        ["etk_exhaust_i4_2.0_diesel","etk_exhaust_i4_2.0_diesel", "Exhaust"],
        ["etk_engine_i4_2.0_diesel_ecu","etk_engine_i4_2.0_diesel_ecu_150", "Engine Management", {"coreSlot":true}],
        ["n2o_system","", "Nitrous Oxide System"],
        ["etk_engine_i4_2.0_diesel_internals","etk_engine_i4_2.0_diesel_internals", "Engine Long Block", {"coreSlot":true}],
        ["etk_transmission","etk_transmission_6M", "Transmission"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine": {
        "torque":[
            ["rpm", "torque"],
            [0,      0],
            [350,   105],
            [600,  152],
            [1000, 158],
            [1750, 172],
            [2000, 179.5],
            [2500, 188.5],
            [3000, 186],
            [4000, 173],
            [4500, 168],
            [5000, 160],
            [6000, 142],
        ],

        "idleRPM":800,
        //max capable
        "maxRPM":5500,
        "inertia":0.18,
        "friction":16,
        "dynamicFriction":0.0239,
        "engineBrakeTorque":26,
