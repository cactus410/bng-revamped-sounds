{
"etk_engine_i4_2.0_diesel": {
    "information":{
        "authors":"BeamNG",
        "name":"2.0L I4 Diesel Engine",
        "value":5600,
    },
    "slotType": "etk_engine",
    "slots": [
        ["type", "default", "description"],
        ["etk_enginemounts","etk_enginemounts", "Engine Mounts", {"coreSlot":true}],
        ["etk_oilpan_i4","etk_oilpan_i4", "Oil Pan", {"coreSlot":true}],
